# OpenRouter API key — used for Jev and for reading the brief (interpreting).
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Generative model for interpreting. `openrouter/free` picks a random free
# model and filters for the features the request needs (structured outputs
# included). Fine for interpreting — low stakes, one short extraction.
OPENROUTER_MODEL=openrouter/free

# Jev — TypeSafe's System One decision model.
JEV_MODEL=~typesafe/jev-latest

# Jev is served from a dedicated alpha endpoint, NOT chat completions.
JEV_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions

# Composing model — proposes the candidate strategies, writes the page inside
# Jev's blueprint, and reviews/repairs it. Paid on purpose: free-tier models
# (OpenRouter's router and Groq's free reasoning models) both proved
# unreliable for page-sized structured calls. gpt-5-nano is OpenAI's cheapest
# current model with native strict json_schema enforcement (constrained
# decoding, not a hint) — a few tenths of a cent per page across all four
# calls. gpt-4o-mini works too but OpenAI is retiring it through 2026. Uses
# the same OPENROUTER_API_KEY above.
COMPOSING_MODEL=openai/gpt-5-nano

# Reasoning effort for the composing model (minimal | low | medium | high).
# Default effort makes a run take minutes; low keeps it near a minute or two.
# Set empty for a model without reasoning support.
COMPOSING_REASONING=low

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to 1 to serve recorded fixtures instead of calling the APIs.
# Free models allow only 50 requests/day — use this while iterating on UI.
USE_FIXTURES=
